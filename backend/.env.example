# Copy this file to .env and fill in your own key.
# Get a key at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=your_key_here

# Shared secret guarding the one endpoint that writes
# (POST /api/restatements/review, which clears the restatement queue).
# The read endpoints are deliberately open. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset means writes are refused outright, so set this before deploying.
STATUS_API_KEY=generate_your_own

# Postgres connection string. Leave unset to use the local SQLite file at
# backend/app.db; the deployed host provides this instead.
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
